#!/bin/csh -f

if ( $#argv != 2 ) then
    echo "Usage: $0 timing_report.gz output.csv"
    exit 1
endif

gzip -cd "$1" | awk 'BEGIN{print "Path,Beginpoint,Endpoint,Slack_ns,Slack_ps"} function emit(){if(p!="" && b!="" && e!="" && got && s>-0.200) printf "%s,%s,%s,%.6f,%.3f\n",p,b,e,s,s*1000} /^Path[[:space:]]+[0-9]+:/ {emit();p=$2;sub(/:$/,"",p);b="";e="";got=0;next} /^[[:space:]]*Beginpoint:/ {sub(/^[[:space:]]*Beginpoint:[[:space:]]*/,"");split($0,a,/[[:space:]]+/);b=a[1];next} /^[[:space:]]*Endpoint:/ {sub(/^[[:space:]]*Endpoint:[[:space:]]*/,"");split($0,a,/[[:space:]]+/);e=a[1];next} /Slack Time/ {x=$0;sub(/^.*Slack Time[[:space:]]*/,"",x);if(match(x,/[-+]?[0-9]*\.?[0-9]+/)){s=substr(x,RSTART,RLENGTH)+0;got=1}} END{emit()}' > "$2"
